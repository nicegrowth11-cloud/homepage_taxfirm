rules_version = '2';
// 상담신청 저장소 보안 규칙 — homepage_taxfirm
// 상담신청은 서버(/api/consult, Vercel 함수)만 서비스 계정으로 기록합니다(서비스 계정은 보안 규칙을 우회).
// 따라서 브라우저(클라이언트 SDK)에서의 읽기·생성·수정·삭제는 모두 거부합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
